{
  "title": "PostgreSQL",
  "uid": "postgresql",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",

  "panels": [
    {
      "type": "row",
      "title": "📊 Overview"
    },

    {
      "type": "stat",
      "title": "Postgres UP",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 }
    },

    {
      "type": "stat",
      "title": "Headroom de conexões",
      "description": "max_connections menos as conexões em uso. É o TETO do eixo de escala do authorization-server: cada réplica abre até AUTH_DB_POOL_SIZE (default 8) conexões, então N réplicas × 8 tem de caber aqui. É o único limite de escala cuja violação FALHA em produção em vez de apenas não ajudar — e o sintoma ('too many clients already') aparece no auth-server, longe da causa. Até esta versão o número não existia em painel nenhum, só em docs/CONFIG.md.",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(pg_settings_max_connections) - sum(pg_stat_activity_count)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 25 }
            ]
          }
        }
      },
      "gridPos": { "x": 4, "y": 1, "w": 5, "h": 4 }
    },

    {
      "type": "stat",
      "title": "Conexões (authdb)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"authdb\"}"
        }
      ],
      "gridPos": { "x": 9, "y": 1, "w": 5, "h": 4 }
    },

    {
      "type": "stat",
      "title": "Locks",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(pg_locks_count{datname=\"authdb\"})"
        }
      ],
      "gridPos": { "x": 14, "y": 1, "w": 5, "h": 4 }
    },

    {
      "type": "stat",
      "title": "Tamanho do banco (authdb)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"authdb\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": { "x": 19, "y": 1, "w": 5, "h": 4 }
    },

    {
      "type": "row",
      "title": "🔌 Conexões"
    },

    {
      "type": "timeseries",
      "title": "Conexões vs teto (max_connections)",
      "description": "O painel a olhar ao escalar o authorization-server: a distância entre as duas linhas é quantas réplicas ainda cabem, a AUTH_DB_POOL_SIZE conexões cada. O Postgres é singleton (SPOF do login, sem réplica) — este teto não cresce adicionando nó, ao contrário de todo o resto do eixo replicável do ADR-024.",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "em uso"
        },
        {
          "expr": "pg_settings_max_connections",
          "legendFormat": "max_connections"
        }
      ],
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 8 }
    },

    {
      "type": "timeseries",
      "title": "Backends por banco",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_stat_database_numbackends",
          "legendFormat": "{{datname}}"
        }
      ],
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 8 }
    },

    {
      "type": "timeseries",
      "title": "Atividade por estado",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count) by (state)",
          "legendFormat": "{{state}}"
        }
      ],
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 }
    },

    {
      "type": "row",
      "title": "🔁 Transações & Locks"
    },

    {
      "type": "timeseries",
      "title": "Transações/s (commit / rollback)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"authdb\"}[1m])",
          "legendFormat": "commit"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"authdb\"}[1m])",
          "legendFormat": "rollback"
        }
      ],
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 }
    },

    {
      "type": "timeseries",
      "title": "Deadlocks/s",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_database_deadlocks{datname=\"authdb\"}[5m])",
          "legendFormat": "deadlocks"
        }
      ],
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 }
    },

    {
      "type": "row",
      "title": "💾 Cache"
    },

    {
      "type": "timeseries",
      "title": "Cache hit ratio (authdb)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"authdb\"} / (pg_stat_database_blks_hit{datname=\"authdb\"} + pg_stat_database_blks_read{datname=\"authdb\"})",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 }
    }
  ]
}
