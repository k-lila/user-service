# Contrato de variáveis de ambiente do docker-compose.yml (versionado, sem segredos reais).
# Copie para .env e preencha com valores reais: cp .env.example .env
# O docker compose carrega o .env automaticamente e interpola ${VAR} no compose.

# MongoDB (root)
MONGO_USER=changeme
MONGO_PASSWORD=changeme

# PostgreSQL (estado OAuth)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# OAuth2 client confidencial (gateway → authorization-server)
OAUTH_CLIENT_SECRET=changeme

# Shared secret do canal interno (auth-server → user-service via X-Internal-Token)
INTERNAL_API_TOKEN=changeme

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
