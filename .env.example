# Contrato de variáveis de ambiente do docker-compose.yml (versionado, sem segredos reais).
# Copie para .env e preencha com valores reais: cp .env.example .env
# O docker compose carrega o .env automaticamente e interpola ${VAR} no compose.

# MongoDB (root)
MONGO_USER=changeme
MONGO_PASSWORD=changeme

# PostgreSQL (estado OAuth)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# OAuth2 client confidencial (gateway → authorization-server)
OAUTH_CLIENT_SECRET=changeme

# Shared secret do canal interno (auth-server → user-service via X-Internal-Token)
INTERNAL_API_TOKEN=changeme

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ──────────────────────────────────────────────────────────────────────────────
# URLs públicas — APENAS para produção (deploy com `docker compose -f docker-compose.yml up`).
#
# Em dev (base + docker-compose.override.yml) estas variáveis NÃO precisam ser setadas:
# o docker-compose.yml já traz defaults de localhost (${VAR:-http://localhost:...}).
# Em prod, descomente e aponte para os hostnames públicos reais (atrás de TLS/ingress — G1).
#
# Borda do app (gateway atrás do proxy do SPA) e front-channel do auth-server num hostname
# dedicado (ex.: https://app.exemplo.com e https://auth.exemplo.com). Lembre que em prod o
# config-server (config-lb:8888) e a porta inteira do auth-server NÃO são publicados.
#
# Porta do host da borda pública (interface/SPA). Dev usa o default 5173; prod tipicamente 80.
# WEB_HOST_PORT=80
#
# OAUTH_AUTHORIZATION_URI=https://auth.exemplo.com/oauth2/authorize
# OAUTH_REDIRECT_URI=https://app.exemplo.com/login/oauth2/code/gateway-client
# OAUTH_GATEWAY_CLIENT=https://app.exemplo.com/login/oauth2/code/gateway-client
# AUTH_URL=https://auth.exemplo.com/oauth2/authorize
# AUTH_TOKEN=https://auth.exemplo.com/oauth2/token
# API_BASE_URL=https://app.exemplo.com
# OAUTH_SWAGGER_REDIRECT_URL=https://app.exemplo.com/swagger-ui/oauth2-redirect.html
# OAUTH2SWAGGER_REDIRECT_URL=https://app.exemplo.com/swagger-ui/oauth2-redirect.html
#
# Logout front-channel (browser): OAUTH_END_SESSION_URI e POST_LOGOUT_REDIRECT_URI também
# precisam dos hostnames públicos em prod. Hoje vêm de defaults no gateway SecurityConfig e
# NÃO são repassados pelo compose — wire junto com o reverse-proxy/ingress do front-channel (G1).
# OAUTH_END_SESSION_URI=https://auth.exemplo.com/connect/logout
# POST_LOGOUT_REDIRECT_URI=https://app.exemplo.com/
